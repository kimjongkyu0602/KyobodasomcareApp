+#if !TARGET_OS_OSX
+- (WKWebView *)kdc_openPopupWithConfiguration:(WKWebViewConfiguration *)configuration
+{
+  if (!_kdcPopups) _kdcPopups = [NSMutableArray new];
+  if (!_kdcPopupNavDelegate) _kdcPopupNavDelegate = [KDCPopupNavigationDelegate new];
+
+  CGRect bounds = self.bounds;
+  CGFloat barHeight = 48;
+  UIView *container = [[UIView alloc] initWithFrame:bounds];
+  container.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+  container.backgroundColor = UIColor.whiteColor;
+
+  UIView *bar = [[UIView alloc] initWithFrame:CGRectMake(0, 0, bounds.size.width, barHeight)];
+  bar.autoresizingMask = UIViewAutoresizingFlexibleWidth;
+  bar.backgroundColor = UIColor.whiteColor;
+  UIView *line = [[UIView alloc] initWithFrame:CGRectMake(0, barHeight - 0.5, bounds.size.width, 0.5)];
+  line.autoresizingMask = UIViewAutoresizingFlexibleWidth;
+  line.backgroundColor = [UIColor colorWithWhite:0.85 alpha:1];
+  [bar addSubview:line];
+
+  UIButton *close = [UIButton buttonWithType:UIButtonTypeSystem];
+  [close setTitle:@"닫기" forState:UIControlStateNormal];
+  [close setTitleColor:[UIColor colorWithWhite:0.2 alpha:1] forState:UIControlStateNormal];
+  close.titleLabel.font = [UIFont systemFontOfSize:16 weight:UIFontWeightMedium];
+  close.frame = CGRectMake(bounds.size.width - 76, 0, 68, barHeight);
+  close.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin;
+  close.accessibilityLabel = @"창 닫기";
+  [close addTarget:self action:@selector(kdc_closeTopPopup) forControlEvents:UIControlEventTouchUpInside];
+  [bar addSubview:close];
+
+  WKWebView *popup = [[WKWebView alloc] initWithFrame:CGRectMake(0, barHeight, bounds.size.width, bounds.size.height - barHeight) configuration:configuration];
+  popup.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+  popup.UIDelegate = self;
+  popup.navigationDelegate = _kdcPopupNavDelegate;
+  popup.allowsBackForwardNavigationGestures = YES;
+  popup.allowsLinkPreview = NO;
+  popup.customUserAgent = _webView.customUserAgent;
+  if (@available(iOS 16.4, *)) {
+    popup.inspectable = _webviewDebuggingEnabled;
+  }
+
+  [container addSubview:popup];
+  [container addSubview:bar];
+  [self addSubview:container];
+  [_kdcPopups addObject:container];
+
+  container.transform = CGAffineTransformMakeTranslation(0, bounds.size.height);
+  [UIView animateWithDuration:0.25 animations:^{
+    container.transform = CGAffineTransformIdentity;
+  }];
+  return popup;
+}
+
+- (void)kdc_removePopup:(UIView *)container
+{
+  if (!container) return;
+  [_kdcPopups removeObject:container];
+  for (UIView *sub in container.subviews) {
+    if ([sub isKindOfClass:[WKWebView class]]) {
+      WKWebView *wv = (WKWebView *)sub;
+      [wv stopLoading];
+      wv.UIDelegate = nil;
+      wv.navigationDelegate = nil;
+    }
+  }
+  [UIView animateWithDuration:0.2 animations:^{
+    container.transform = CGAffineTransformMakeTranslation(0, container.bounds.size.height);
+  } completion:^(__unused BOOL finished) {
+    [container removeFromSuperview];
+  }];
+}
+
+- (void)kdc_closeTopPopup
+{
+  [self kdc_removePopup:_kdcPopups.lastObject];
+}
+
+- (void)kdc_closeAllPopups
+{
+  for (UIView *container in [_kdcPopups copy]) {
+    [self kdc_removePopup:container];
+  }
+}
+
+/** 웹에서 window.close() 를 호출하면 팝업을 닫습니다. */
+- (void)webViewDidClose:(WKWebView *)webView
+{
+  for (UIView *container in [_kdcPopups copy]) {
+    if ([webView isDescendantOfView:container]) {
+      [self kdc_removePopup:container];
+      return;
+    }
+  }
+}
+#endif
